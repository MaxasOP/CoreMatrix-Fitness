## Backend Environment Variables Configuration

# === Database ===
## Example: MongoDB Atlas connection string
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/corematrix?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/corematrix
JWT_SECRET=7fK@92Lm!xQw#4PzR8uYvT1nBc$5Hd
JWT_EXPIRY=7d
PORT=4000
NODE_ENV=development

# === AI Services ===
## Gemini API for meal plans, form analysis, health scores
GEMINI_API_KEY=your_gemini_api_key_here
PYTHON_SERVICE_URL=http://localhost:5000

# === File Upload & Media ===
## Cloudinary for image/video hosting
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# === Email Service ===
## SendGrid for notifications and emails
SENDGRID_API_KEY=SG.your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@corematrix.com

# === SMS Service ===
## Twilio for SMS notifications
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# === Redis ===
## For caching and real-time features
REDIS_URL=redis://localhost:6379

# === Frontend URL ===
## For CORS and redirects
FRONTEND_URL=http://localhost:3000

# === Feature Flags ===
ENABLE_AI_FEATURES=true
ENABLE_VIDEO_UPLOAD=true
ENABLE_CHALLENGES=true
ENABLE_LEADERBOARDS=true
ENABLE_SOCIAL_FEATURES=true
